<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Store Header and Title -->
    <TextView
        android:id="@+id/store_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZYRON MOD MARKET"
        android:textColor="#FF3B30"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Search Bar for Mods (Sodium, Physics Mod, Create, etc.) -->
    <EditText
        android:id="@+id/search_bar_mods"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/store_title"
        android:background="@drawable/zyron_button"
        android:hint="Search Mods (e.g., Sodium, Create)..."
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93"
        android:paddingStart="15dp"
        android:layout_marginBottom="16dp"/>

    <!-- Dynamic Scrollable Container for Mod Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/search_bar_mods">

        <LinearLayout
            android:id="@+id/mods_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sample Mod Entry Item Frame (Template for Code Generation) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="#121212"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                
                <!-- Mod Info Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sodium Optimizer"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boosts FPS and fixes rendering errors seamlessly."
                        android:textColor="#8E8E93"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- One-Click Quick Install Button -->
                <Button
                    android:id="@+id/btn_install_mod_sample"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="@drawable/zyron_button"
                    android:text="INSTALL"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
